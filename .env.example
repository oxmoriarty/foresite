# ==============================================================================
# ForeSite Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# All VITE_ prefixed variables are bundled into client code.
# NEVER commit private server secrets, service account keys, or tokens.
# ==============================================================================

# Application Metadata
VITE_APP_NAME="ForeSite"
VITE_APP_ENV="development"
VITE_APP_VERSION="0.1.0"

# Firebase Client Configuration (Spark Plan - 100% Free)
# These will be configured during Phase 2 (Firebase Setup)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Firebase App Check (Web Debug Token for local development)
VITE_APP_CHECK_DEBUG_TOKEN=""
